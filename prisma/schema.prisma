generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum Status {
  PRESENT
  ABSENT
}

model User {
  userId     Int     @id @default(autoincrement())
  name       String
  email      String  @unique
  password   String
  university String?
  role       Role
  uuid       String?

  createdAt DateTime @default(now())

  classesTeaching Class[]      @relation("TeacherClasses")
  enrollments     Enrollment[]
  attendances     Attendance[]
}

model Class {
  id        Int    @id @default(autoincrement())
  name      String
  teacherId Int
  teacher   User   @relation("TeacherClasses", fields: [teacherId], references: [userId])

  recurrenceDays Weekday[]
  startDate      DateTime  @db.Date
  endDate        DateTime  @db.Date

  enrollments Enrollment[]
  sessions    Session[]

  createdAt DateTime @default(now())
}

model Session {
  id      Int      @id @default(autoincrement())
  classId Int
  date    DateTime @db.Date

  isAttendanceOpen Boolean @default(false)

  // Cascade: deleting a class deletes its sessions;
  // deleting a session deletes its attendance records.
  class       Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  attendances Attendance[]

  createdAt DateTime @default(now())

  @@unique([classId, date])
}

model Enrollment {
  id        Int @id @default(autoincrement())
  classId   Int
  studentId Int

  // Cascade: deleting a class removes its enrollments.
  class   Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  student User  @relation(fields: [studentId], references: [userId])

  @@unique([classId, studentId])
}

model Attendance {
  id        Int      @id @default(autoincrement())
  date      DateTime @default(now())
  sessionId Int
  studentId Int
  status    Status

  // Cascade: deleting a session removes its attendance records.
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student User    @relation(fields: [studentId], references: [userId])

  @@unique([sessionId, studentId])
}
